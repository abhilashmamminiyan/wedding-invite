# ==============================================================================
# SECURE SERVER-ONLY CONFIGURATION
# Notice: NEVER prefix these with NEXT_PUBLIC_
# This ensures that credentials, sheet IDs, and service accounts are NEVER bundled
# into client-side JS or visible in the browser Network or Console tabs.
# ==============================================================================

# Private Google Sheet ID (From the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_private_google_sheet_id_here

# Specific Tab Name in your Google Sheet (e.g., "Form Responses 1")
GOOGLE_SHEET_TAB_NAME=Form Responses 1

# Optional: Google Service Account Credentials (if sheet is restricted/private)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: Direct CSV publish URL (if published privately to web)
GOOGLE_SHEET_CSV_URL=

# App base URL for OpenGraph metadata and dynamic .ics calendar generation
APP_BASE_URL=http://localhost:3000
